+        public static bool IsCoreFrame(int index)
+        {
+            int lo = 0, hi = CoreFrames.Length - 1;
+            while (lo <= hi)
+            {
+                int mid = (lo + hi) >> 1;
+                int v = CoreFrames[mid];
+                if (v == index) return true;
+                if (v < index) lo = mid + 1;
+                else hi = mid - 1;
+            }
+            return false;
+        }
