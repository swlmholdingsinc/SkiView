diff --git a/Assets/SkiView/Scripts/Logic/EntryGateRules.cs b/Assets/SkiView/Scripts/Logic/EntryGateRules.cs
new file mode 100644
index 0000000..d5009f1
--- /dev/null
+++ b/Assets/SkiView/Scripts/Logic/EntryGateRules.cs
@@ -0,0 +1,39 @@
+namespace SkiView.Logic
+{
+    /// <summary>
+    /// IWWF Tournament Water Ski Rules, Rule 8.08(b) and 8.09, and Rule 8.13 scoring procedure
+    /// (IWWF World Waterski Rules 2026, 1 March 2026, https://iwwf.sport/wp-content/uploads/2026/03/IWWF-World-Waterski-Rules-2026-FINAL.pdf).
+    /// A skier misses the entry or exit gate when the ski centreline passes outside the centre of the gate buoy.
+    /// A missed entry gate is an official 0. Buoys rounded after that miss are not added.
+    /// A missed exit gate, after the entry was made and buoy 6 was reached, is 6 if the skier is outside on the
+    /// right, and 5.5 if outside on the left. The same line is used at every rope length.
+    /// </summary>
+    public static class EntryGateRules
+    {
+        public const float GateHalfM = 1.25f;
+
+        public static bool Made(float absX)
+        {
+            if (float.IsNaN(absX) || float.IsInfinity(absX)) return false;
+            return absX <= GateHalfM;
+        }
+
+        public static bool PillFilled(float xAtGate) => Made(Abs(xAtGate));
+
+        public static float OfficialScore(int rope, float xAtEntry, float buoysIfEntryMade, bool exitJudged, float xAtExit)
+        {
+            if (rope < 0) rope = 0;
+            if (rope > 8) rope = 8;
+            if (!Made(Abs(xAtEntry))) return 0f;
+            float buoys = buoysIfEntryMade;
+            if (float.IsNaN(buoys) || buoys < 0f) buoys = 0f;
+            if (buoys > 6f) buoys = 6f;
+            if (!exitJudged) return buoys;
+            if (Made(Abs(xAtExit))) return buoys;
+            if (buoys < 5.5f) return buoys;
+            return xAtExit > 0f ? 6f : 5.5f;
+        }
+
+        static float Abs(float v) => v < 0f ? -v : v;
+    }
+}
